msgstr "No se pudo abrir el socket de control ({err}); subcomandos de la CLI desactivados."

#: src/main.py:261
#, python-brace-format
msgid "The script is ready. Current model: {model_name}"
msgstr "El script está listo. Modelo actual: {model_name}"

#: src/main.py:275
msgid "Control queue full; command ignored."
msgstr "Cola de control llena; comando ignorado."

#: src/main.py:280
