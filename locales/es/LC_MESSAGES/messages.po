#: src/main.py:110
#, python-brace-format
msgid "  - Hold [{key}] to dictate; release to stop and copy."
msgstr "  - Mantenga pulsada [{key}] para dictar; suéltela para detener y copiar."

#: src/main.py:111
#, python-brace-format
msgid "  - Say '{stop_phrase}' or run 'vosk-cli-dictation --finalize' to stop early."
msgstr "  - Diga «{stop_phrase}» o ejecute «vosk-cli-dictation --finalize» para detener antes."

#: src/main.py:112 src/main.py:119 src/main.py:125
msgid "  - Hotkeys reach the focused window and miss native-Wayland windows; use --finalize."
msgstr "  - Los atajos alcanzan la ventana enfocada y no llegan a las ventanas Wayland nativas; use --finalize."

#: src/main.py:117
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start."
msgstr "  - Diga «{wake_phrase}» o pulse {hotkey} para empezar."

#: src/main.py:118
#, python-brace-format
msgid "  - Stops and copies on its own after {timeout_ms} ms of silence, or say '{stop_phrase}' / press {hotkey} / run 'vosk-cli-dictation --finalize' to stop early."
msgstr "  - Se detiene y se copia sola tras {timeout_ms} ms de silencio, o diga «{stop_phrase}» / pulse {hotkey} / ejecute «vosk-cli-dictation --finalize» para detener antes."

#: src/main.py:123
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start/stop."
msgstr "  - Diga «{wake_phrase}» o pulse {hotkey} para iniciar/detener."

#: src/main.py:124
#, python-brace-format
msgid "  - Say '{stop_phrase}', press {hotkey}, or run 'vosk-cli-dictation --finalize' to stop and copy."
msgstr "  - Diga «{stop_phrase}», pulse {hotkey}, o ejecute «vosk-cli-dictation --finalize» para detener y copiar."

