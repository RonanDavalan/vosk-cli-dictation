#: src/main.py:55
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start/stop."
msgstr "  - Diga «{wake_phrase}» o pulse {hotkey} para iniciar/detener."

#: src/main.py:56
#, python-brace-format
msgid "  - Say '{stop_phrase}', press {hotkey}, or run 'vosk-cli-dictation --finalize' to stop and copy."
msgstr "  - Diga «{stop_phrase}», pulse {hotkey}, o ejecute «vosk-cli-dictation --finalize» para detener y copiar."

#: src/main.py:57
msgid "  - Hotkeys are X11-only and reach the focused window; use --finalize."
msgstr "  - Los atajos de teclado solo funcionan en X11 y llegan a la ventana activa; use --finalize."

#: src/main.py:59
#, python-brace-format
msgid "\n{style}  Manual commands:{reset}"
msgstr "\n{style}  Comandos manuales:{reset}"

#: src/main.py:60
msgid "  - '/cancel', '/delete-word', '/nl'"
msgstr "  - '/cancel', '/delete-word', '/nl'"

#: src/main.py:65
#, python-brace-format
msgid "\n{style}  Punctuation commands:{reset}"
msgstr "\n{style}  Comandos de puntuación:{reset}"

#: src/main.py:95
msgid "Press Ctrl+C to exit the program."
msgstr "Pulse Ctrl+C para salir del programa."

#: src/main.py:102
msgid "\nProgram stopped cleanly."
msgstr "\nPrograma detenido correctamente."

#: src/main.py:116
msgid "A Vosk-based command-line dictation tool."
msgstr "Herramienta de dictado por línea de comandos basada en Vosk."

#: src/main.py:117
msgid "Force the interface and model language."
msgstr "Forzar el idioma de la interfaz y del modelo."

#: src/main.py:118
msgid "control an already running session"
msgstr "controlar una sesión ya en curso"

#: src/main.py:119
msgid "toggle dictation on/off"
msgstr "alternar el dictado activado/desactivado"

#: src/main.py:120
msgid "start dictation"
msgstr "iniciar el dictado"

#: src/main.py:121
msgid "stop dictation, keep listening"
msgstr "detener el dictado, seguir escuchando"

#: src/main.py:122
msgid "finalize the session and copy the text"
msgstr "finalizar la sesión y copiar el texto"

#: src/main.py:123
msgid "discard the current session buffer"
msgstr "descartar el búfer de la sesión actual"

#: src/main.py:124
msgid "enter deep sleep (release the microphone)"
msgstr "entrar en reposo profundo (liberar el micrófono)"

#: src/main.py:125
msgid "leave deep sleep"
msgstr "salir del reposo profundo"

#: src/main.py:126
msgid "toggle deep sleep"
msgstr "alternar el reposo profundo"

#: src/main.py:127
msgid "print the current state"
msgstr "mostrar el estado actual"

#: src/main.py:128
msgid "stop the running session"
msgstr "detener la sesión en curso"

#: src/main.py:129
msgid "check the environment and exit"
msgstr "comprobar el entorno y salir"

#: src/main.py:131
msgid "download the small model for LANG (or the current language) and exit"
msgstr "descargar el modelo pequeño para LANG (o el idioma actual) y salir"

#: src/main.py:147
msgid "No running vosk-cli-dictation session."
msgstr "No hay ninguna sesión de vosk-cli-dictation en curso."

#: src/main.py:165
msgid "A vosk-cli-dictation session is already running (see --status)."
msgstr "Ya hay una sesión de vosk-cli-dictation en curso (véase --status)."

#: src/main.py:168
msgid "Checking external dependencies..."
msgstr "Comprobando dependencias externas..."

#: src/main.py:170
msgid "No text-injection backend available for this session."
msgstr "No hay ningún motor de inyección de texto disponible para esta sesión."

#: src/main.py:171
msgid "Install 'wtype' + 'wl-clipboard' (Wayland) or 'xdotool' (X11); 'ydotool' also works."
msgstr "Instale 'wtype' + 'wl-clipboard' (Wayland) o 'xdotool' (X11); 'ydotool' también funciona."

#: src/main.py:174
msgid "'paplay' not found. Sound notifications will be disabled."
msgstr "No se encontró 'paplay'. Las notificaciones sonoras se desactivarán."

#: src/main.py:175
msgid "Dependencies checked."
msgstr "Dependencias comprobadas."

#: src/main.py:177
#, python-brace-format
msgid "Attempting to load model for language: {lang}"
msgstr "Intentando cargar el modelo para el idioma: {lang}"

#: src/main.py:183
#, python-brace-format
msgid "Failed. Attempting to load default model: {model_name}"
msgstr "Fallo. Intentando cargar el modelo por defecto: {model_name}"

#: src/main.py:187
#, python-brace-format
msgid "No speech recognition model could be loaded. Download the small model for '{lang}' now? [y/N] "
msgstr "No se pudo cargar ningún modelo de reconocimiento de voz. ¿Descargar ahora el modelo pequeño para '{lang}'? [s/N] "

#: src/main.py:194
msgid "No speech recognition model could be loaded."
msgstr "No se pudo cargar ningún modelo de reconocimiento de voz."

#: src/main.py:195
#, python-brace-format
msgid "Run 'vosk-cli-dictation --download-model {lang}' to download one."
msgstr "Ejecute «vosk-cli-dictation --download-model {lang}» para descargar uno."

#: src/main.py:196
msgid "Please check the model paths and integrity in your config.yaml file."
msgstr "Compruebe las rutas y la integridad de los modelos en su archivo config.yaml."

