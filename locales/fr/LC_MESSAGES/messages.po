#: src/main.py:55
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start/stop."
msgstr "  - Dites « {wake_phrase} » ou appuyez sur {hotkey} pour démarrer/arrêter."

#: src/main.py:56
#, python-brace-format
msgid "  - Say '{stop_phrase}', press {hotkey}, or run 'vosk-cli-dictation --finalize' to stop and copy."
msgstr "  - Dites « {stop_phrase} », appuyez sur {hotkey}, ou lancez « vosk-cli-dictation --finalize » pour arrêter et copier."

#: src/main.py:57
msgid "  - Hotkeys are X11-only and reach the focused window; use --finalize."
msgstr "  - Les raccourcis clavier sont réservés à X11 et atteignent la fenêtre active ; utilisez --finalize."

#: src/main.py:59
#, python-brace-format
msgid "\n{style}  Manual commands:{reset}"
msgstr "\n{style}  Commandes manuelles :{reset}"

#: src/main.py:60
msgid "  - '/cancel', '/delete-word', '/nl'"
msgstr "  - '/cancel', '/delete-word', '/nl'"

#: src/main.py:65
#, python-brace-format
msgid "\n{style}  Punctuation commands:{reset}"
msgstr "\n{style}  Commandes de ponctuation :{reset}"

#: src/main.py:95
msgid "Press Ctrl+C to exit the program."
msgstr "Appuyez sur Ctrl+C pour quitter le programme."

#: src/main.py:102
msgid "\nProgram stopped cleanly."
msgstr "\nProgramme arrêté proprement."

#: src/main.py:116
msgid "A Vosk-based command-line dictation tool."
msgstr "Outil de dictée en ligne de commande basé sur Vosk."

#: src/main.py:117
msgid "Force the interface and model language."
msgstr "Forcer la langue de l'interface et du modèle."

#: src/main.py:118
msgid "control an already running session"
msgstr "contrôler une session déjà en cours"

#: src/main.py:119
msgid "toggle dictation on/off"
msgstr "basculer la dictée activée/désactivée"

#: src/main.py:120
msgid "start dictation"
msgstr "démarrer la dictée"

#: src/main.py:121
msgid "stop dictation, keep listening"
msgstr "arrêter la dictée, continuer à écouter"

#: src/main.py:122
msgid "finalize the session and copy the text"
msgstr "finaliser la session et copier le texte"

#: src/main.py:123
msgid "discard the current session buffer"
msgstr "annuler le tampon de la session en cours"

#: src/main.py:124
msgid "enter deep sleep (release the microphone)"
msgstr "entrer en veille prolongée (libérer le microphone)"

#: src/main.py:125
msgid "leave deep sleep"
msgstr "sortir de la veille prolongée"

#: src/main.py:126
msgid "toggle deep sleep"
msgstr "basculer la veille prolongée"

#: src/main.py:127
msgid "print the current state"
msgstr "afficher l'état actuel"

#: src/main.py:128
msgid "stop the running session"
msgstr "arrêter la session en cours"

#: src/main.py:129
msgid "check the environment and exit"
msgstr "vérifier l'environnement et quitter"

#: src/main.py:131
msgid "download the small model for LANG (or the current language) and exit"
msgstr "télécharger le petit modèle pour LANG (ou la langue actuelle) et quitter"

#: src/main.py:147
msgid "No running vosk-cli-dictation session."
msgstr "Aucune session vosk-cli-dictation en cours."

#: src/main.py:165
msgid "A vosk-cli-dictation session is already running (see --status)."
msgstr "Une session vosk-cli-dictation est déjà en cours (voir --status)."

#: src/main.py:168
msgid "Checking external dependencies..."
msgstr "Vérification des dépendances externes..."

#: src/main.py:170
msgid "No text-injection backend available for this session."
msgstr "Aucun moteur d'injection de texte disponible pour cette session."

#: src/main.py:171
msgid "Install 'wtype' + 'wl-clipboard' (Wayland) or 'xdotool' (X11); 'ydotool' also works."
msgstr "Installez 'wtype' + 'wl-clipboard' (Wayland) ou 'xdotool' (X11) ; 'ydotool' fonctionne aussi."

#: src/main.py:174
msgid "'paplay' not found. Sound notifications will be disabled."
msgstr "'paplay' non trouvé. Les notifications sonores seront désactivées."

#: src/main.py:175
msgid "Dependencies checked."
msgstr "Dépendances vérifiées."

#: src/main.py:177
#, python-brace-format
