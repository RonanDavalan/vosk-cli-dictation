#: src/main.py:85
#, python-brace-format
msgid "  - Hold [{key}] to dictate; release to stop and copy."
msgstr "  - Maintenez [{key}] enfoncée pour dicter ; relâchez pour arrêter et copier."

#: src/main.py:86
#, python-brace-format
msgid "  - Say '{stop_phrase}' or run 'vosk-cli-dictation --finalize' to stop early."
msgstr "  - Dites « {stop_phrase} » ou lancez « vosk-cli-dictation --finalize » pour arrêter plus tôt."

#: src/main.py:87 src/main.py:94 src/main.py:100
msgid "  - Hotkeys reach the focused window and miss native-Wayland windows; use --finalize."
msgstr "  - Les raccourcis atteignent la fenêtre active et manquent les fenêtres Wayland natives ; utilisez --finalize."

#: src/main.py:92
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start."
msgstr "  - Dites « {wake_phrase} » ou appuyez sur {hotkey} pour démarrer."

#: src/main.py:93
#, python-brace-format
msgid "  - Stops and copies on its own after {timeout_ms} ms of silence, or say '{stop_phrase}' / press {hotkey} / run 'vosk-cli-dictation --finalize' to stop early."
msgstr "  - S'arrête et se copie seule après {timeout_ms} ms de silence, ou dites « {stop_phrase} » / appuyez sur {hotkey} / lancez « vosk-cli-dictation --finalize » pour arrêter plus tôt."

#: src/main.py:98
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start/stop."
msgstr "  - Dites « {wake_phrase} » ou appuyez sur {hotkey} pour démarrer/arrêter."

#: src/main.py:99
#, python-brace-format
msgid "  - Say '{stop_phrase}', press {hotkey}, or run 'vosk-cli-dictation --finalize' to stop and copy."
msgstr "  - Dites « {stop_phrase} », appuyez sur {hotkey}, ou lancez « vosk-cli-dictation --finalize » pour arrêter et copier."

