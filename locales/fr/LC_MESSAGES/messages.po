#, python-brace-format
msgid "No speech recognition model could be loaded. Download the small model for '{lang}' now? [y/N] "
msgstr "Aucun modèle de reconnaissance vocale n'a pu être chargé. Télécharger le petit modèle pour '{lang}' maintenant ? [o/N] "

#: src/main.py:194
msgid "No speech recognition model could be loaded."
msgstr "Aucun modèle de reconnaissance vocale n'a pu être chargé."

#: src/main.py:195
#, python-brace-format
msgid "Run 'vosk-cli-dictation --download-model {lang}' to download one."
msgstr "Lancez « vosk-cli-dictation --download-model {lang} » pour en télécharger un."

#: src/main.py:196
msgid "Please check the model paths and integrity in your config.yaml file."
msgstr "Veuillez vérifier les chemins et l'intégrité des modèles dans votre fichier config.yaml."

