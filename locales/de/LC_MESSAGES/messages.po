#: src/main.py:110
#, python-brace-format
msgid "  - Hold [{key}] to dictate; release to stop and copy."
msgstr "  - Halten Sie [{key}] gedrückt, um zu diktieren; loslassen, um zu stoppen und zu kopieren."

#: src/main.py:111
#, python-brace-format
msgid "  - Say '{stop_phrase}' or run 'vosk-cli-dictation --finalize' to stop early."
msgstr "  - Sagen Sie „{stop_phrase}“ oder führen Sie „vosk-cli-dictation --finalize“ aus, um vorzeitig zu stoppen."

#: src/main.py:112 src/main.py:119 src/main.py:125
msgid "  - Hotkeys reach the focused window and miss native-Wayland windows; use --finalize."
msgstr "  - Tastenkombinationen erreichen das fokussierte Fenster und verfehlen native Wayland-Fenster; verwenden Sie --finalize."

#: src/main.py:117
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start."
msgstr "  - Sagen Sie „{wake_phrase}“ oder drücken Sie {hotkey}, um zu starten."

#: src/main.py:118
#, python-brace-format
msgid "  - Stops and copies on its own after {timeout_ms} ms of silence, or say '{stop_phrase}' / press {hotkey} / run 'vosk-cli-dictation --finalize' to stop early."
msgstr "  - Stoppt und kopiert sich nach {timeout_ms} ms Stille von selbst, oder sagen Sie „{stop_phrase}“ / drücken Sie {hotkey} / führen Sie „vosk-cli-dictation --finalize“ aus, um vorzeitig zu stoppen."

#: src/main.py:123
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start/stop."
msgstr "  - Sagen Sie „{wake_phrase}“ oder drücken Sie {hotkey}, um zu starten/stoppen."

#: src/main.py:124
#, python-brace-format
msgid "  - Say '{stop_phrase}', press {hotkey}, or run 'vosk-cli-dictation --finalize' to stop and copy."
msgstr "  - Sagen Sie „{stop_phrase}“, drücken Sie {hotkey}, oder führen Sie „vosk-cli-dictation --finalize“ aus, um zu stoppen und zu kopieren."

