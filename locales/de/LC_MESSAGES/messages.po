#: src/main.py:55
#, python-brace-format
msgid "  - Say '{wake_phrase}' or press {hotkey} to start/stop."
msgstr "  - Sagen Sie „{wake_phrase}“ oder drücken Sie {hotkey}, um zu starten/stoppen."

#: src/main.py:56
#, python-brace-format
msgid "  - Say '{stop_phrase}', press {hotkey}, or run 'vosk-cli-dictation --finalize' to stop and copy."
msgstr "  - Sagen Sie „{stop_phrase}“, drücken Sie {hotkey}, oder führen Sie „vosk-cli-dictation --finalize“ aus, um zu stoppen und zu kopieren."

#: src/main.py:57
msgid "  - Hotkeys are X11-only and reach the focused window; use --finalize."
msgstr "  - Tastenkombinationen funktionieren nur unter X11 und erreichen das aktive Fenster; verwenden Sie --finalize."

#: src/main.py:59
#, python-brace-format
msgid "\n{style}  Manual commands:{reset}"
msgstr "\n{style}  Manuelle Befehle:{reset}"

#: src/main.py:60
msgid "  - '/cancel', '/delete-word', '/nl'"
msgstr "  - '/cancel', '/delete-word', '/nl'"

#: src/main.py:65
#, python-brace-format
msgid "\n{style}  Punctuation commands:{reset}"
msgstr "\n{style}  Satzzeichen-Befehle:{reset}"

#: src/main.py:95
msgid "Press Ctrl+C to exit the program."
msgstr "Drücken Sie Strg+C, um das Programm zu beenden."

#: src/main.py:102
msgid "\nProgram stopped cleanly."
msgstr "\nProgramm sauber beendet."

#: src/main.py:116
msgid "A Vosk-based command-line dictation tool."
msgstr "Ein Diktierwerkzeug für die Befehlszeile auf Basis von Vosk."

#: src/main.py:117
msgid "Force the interface and model language."
msgstr "Sprache der Oberfläche und des Modells erzwingen."

#: src/main.py:118
msgid "control an already running session"
msgstr "eine bereits laufende Sitzung steuern"

#: src/main.py:119
msgid "toggle dictation on/off"
msgstr "Diktat ein-/ausschalten"

#: src/main.py:120
msgid "start dictation"
msgstr "Diktat starten"

#: src/main.py:121
msgid "stop dictation, keep listening"
msgstr "Diktat stoppen, Zuhören fortsetzen"

#: src/main.py:122
msgid "finalize the session and copy the text"
msgstr "Sitzung abschließen und den Text kopieren"

#: src/main.py:123
msgid "discard the current session buffer"
msgstr "den aktuellen Sitzungspuffer verwerfen"

#: src/main.py:124
msgid "enter deep sleep (release the microphone)"
msgstr "in den Tiefschlaf wechseln (Mikrofon freigeben)"

#: src/main.py:125
msgid "leave deep sleep"
msgstr "den Tiefschlaf verlassen"

#: src/main.py:126
msgid "toggle deep sleep"
msgstr "Tiefschlaf umschalten"

#: src/main.py:127
msgid "print the current state"
msgstr "den aktuellen Zustand anzeigen"

#: src/main.py:128
msgid "stop the running session"
msgstr "die laufende Sitzung beenden"

#: src/main.py:129
msgid "check the environment and exit"
msgstr "die Umgebung prüfen und beenden"

#: src/main.py:131
msgid "download the small model for LANG (or the current language) and exit"
msgstr "das kleine Modell für LANG (oder die aktuelle Sprache) herunterladen und beenden"

#: src/main.py:147
msgid "No running vosk-cli-dictation session."
msgstr "Keine laufende vosk-cli-dictation-Sitzung."

#: src/main.py:165
msgid "A vosk-cli-dictation session is already running (see --status)."
msgstr "Es läuft bereits eine vosk-cli-dictation-Sitzung (siehe --status)."

#: src/main.py:168
msgid "Checking external dependencies..."
msgstr "Externe Abhängigkeiten werden geprüft..."

#: src/main.py:170
msgid "No text-injection backend available for this session."
msgstr "Kein Backend für Texteingabe für diese Sitzung verfügbar."

#: src/main.py:171
msgid "Install 'wtype' + 'wl-clipboard' (Wayland) or 'xdotool' (X11); 'ydotool' also works."
msgstr "Installieren Sie 'wtype' + 'wl-clipboard' (Wayland) oder 'xdotool' (X11); 'ydotool' funktioniert auch."

#: src/main.py:174
msgid "'paplay' not found. Sound notifications will be disabled."
msgstr "'paplay' nicht gefunden. Tonbenachrichtigungen werden deaktiviert."

#: src/main.py:175
msgid "Dependencies checked."
msgstr "Abhängigkeiten geprüft."

#: src/main.py:177
#, python-brace-format
