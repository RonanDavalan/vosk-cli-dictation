#, python-brace-format
msgid "No speech recognition model could be loaded. Download the small model for '{lang}' now? [y/N] "
msgstr "Es konnte kein Spracherkennungsmodell geladen werden. Jetzt das kleine Modell für '{lang}' herunterladen? [j/N] "

#: src/main.py:194
msgid "No speech recognition model could be loaded."
msgstr "Es konnte kein Spracherkennungsmodell geladen werden."

#: src/main.py:195
#, python-brace-format
